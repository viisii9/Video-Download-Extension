{
  "manifest_version": 3,
  "name": "Video Finder",
  "version": "1.0",
  "description": "Finds video files on the current webpage.",
  "permissions": ["activeTab", "scripting", "webRequest", "webRequestBlocking", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon16.png",
      "128": "icon16.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}